# URL Backend WordPress Headless (Không có dấu / ở cuối)
NEXT_PUBLIC_WORDPRESS_URL=https://your-wp-backend.com

# 🔑 HomeNest API Secret Key (Trùng với define('HN_API_SECRET', '...') trên WordPress)
HN_API_SECRET=your_hn_api_secret_key_here

# URL Frontend Next.js (Không có dấu / ở cuối)
NEXT_PUBLIC_SITE_URL=https://your-site-domain.com

# Thời gian cache ISR (giây) - Chuẩn HomeNest: 3600 giây (1 giờ)
REVALIDATE_TIME=3600

# Port Next.js container (Mặc định: 2903)
PORT=2903
